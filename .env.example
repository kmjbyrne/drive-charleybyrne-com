# S3 Configuration
NUXT_S3_BUCKET=storage-charleybyrne-files
NUXT_S3_REGION=eu-west-1
NUXT_S3_ENDPOINT=

# AWS Credentials (omit when using IAM roles)
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=

# Storage
NUXT_STORAGE_QUOTA_BYTES=21474836480

