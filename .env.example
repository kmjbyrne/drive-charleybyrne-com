# Storage driver: "local" or "s3"
NUXT_STORAGE_DRIVER=local

# S3 Configuration (only used when NUXT_STORAGE_DRIVER=s3)
NUXT_S3_BUCKET=storage-charleybyrne-files
NUXT_S3_REGION=eu-west-1
NUXT_S3_ENDPOINT=

# AWS Credentials (omit when using IAM roles)
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=

# Dev auth bypass (set to true to skip Janus auth in development)
# NUXT_AUTH_BYPASS=true

# Janus Auth (server-only secrets)
NUXT_JANUS_URL=https://auth.charleybyrne.com/api
NUXT_JANUS_CLIENT_ID=
NUXT_JANUS_CLIENT_SECRET=
NUXT_JANUS_APP_IDENTIFIER=https://drive.charleybyrne.com

# Janus Auth (public, exposed to browser)
# The URL of the Janus login UI — users are redirected here to authenticate
NUXT_PUBLIC_JANUS_UI_URL=https://auth.v2.charleybyrne.com
NUXT_PUBLIC_JANUS_CLIENT_ID=
# The URL of this app — Janus redirects back here after successful login
NUXT_PUBLIC_APP_URL=https://drive.charleybyrne.com

# Storage
NUXT_STORAGE_QUOTA_BYTES=21474836480

# Local development with MinIO
# NUXT_S3_BUCKET=storage-dev
# NUXT_S3_REGION=us-east-1
# NUXT_S3_ENDPOINT=http://localhost:9000
# NUXT_S3_ACCESS_KEY_ID=minioadmin
# NUXT_S3_SECRET_ACCESS_KEY=minioadmin
